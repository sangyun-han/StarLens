# StarLens frontend configuration (Vite — only VITE_* vars reach the browser)

# Where the browser sends API calls. Defaults to "/api/v1", which the dev server
# proxies to the Go backend, keeping the app same-origin.
# VITE_API_BASE_URL=/api/v1

# Dev-server proxy target for /api. Point this at a remote StarLens API if the
# backend does not run on localhost:8080.
# VITE_PROXY_TARGET=http://localhost:8080
