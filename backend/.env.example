# StarLens backend configuration
#
# Copy to `.env` for reference, then export the values before running the server:
#   set -a && source .env && set +a && go run ./cmd/server

# --- StarRocks connection -----------------------------------------------------
# Preferred: a full go-sql-driver/mysql DSN pointing at an FE query port (9030).
# Format: user:password@tcp(host:port)/database?params
# Note: parseTime is deliberately left off — StarRocks returns "0000-00-00 00:00:00"
# for nodes that never started, which the driver cannot convert to time.Time.
STARROCKS_DSN=root:@tcp(127.0.0.1:9030)/information_schema?charset=utf8mb4&timeout=5s

# Alternative: leave STARROCKS_DSN empty and set the parts individually.
# STARROCKS_HOST=127.0.0.1
# STARROCKS_PORT=9030
# STARROCKS_USER=root
# STARROCKS_PASSWORD=
# STARROCKS_DATABASE=information_schema

# --- Connection pool ----------------------------------------------------------
STARROCKS_MAX_OPEN_CONNS=25
STARROCKS_MAX_IDLE_CONNS=10
STARROCKS_CONN_MAX_LIFETIME=30m
STARROCKS_QUERY_TIMEOUT=10s

# --- Alerting -----------------------------------------------------------------
# Background evaluation of routine load alert rules. Alerts always go to the
# server log; set ALERT_WEBHOOK_URL to also deliver them over HTTP.
ALERT_ENABLED=true
ALERT_POLL_INTERVAL=30s
# Repeats of the same alert (same rule + job) are suppressed for this long.
ALERT_COOLDOWN=10m

# Webhook delivery (optional). Format "generic" posts the full alert JSON;
# "slack" posts {"text": ...} for Slack-compatible incoming webhooks.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
ALERT_WEBHOOK_FORMAT=generic

# Rule thresholds. <= 0 disables the rule.
# Fire when errorRows/totalRows exceeds this fraction (0.01 = 1%) ...
ALERT_ERROR_ROWS_RATIO=0.01
# ... but only once a job has consumed at least this many rows.
ALERT_ERROR_ROWS_MIN_TOTAL=10000
# Fire when a job trails the source log end by more than this many messages
# (requires a StarRocks version that reports LatestSourcePosition). 0 = off.
ALERT_MAX_OFFSET_LAG=0

# --- HTTP server --------------------------------------------------------------
SERVER_PORT=8080
# Comma-separated list of allowed browser origins for CORS (dev Vite server).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# debug | release
GIN_MODE=debug
